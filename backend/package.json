{
  "name": "vetting-copilot-backend",
  "version": "1.0.0",
  "description": "Enterprise AI Due Diligence & Risk Intelligence Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js --banner:js=\"/* import 'express'; */\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsc --noEmit && tsx test/audit.test.ts",
    "test:keploy": "tsx test/audit.test.ts"
  },
  "keywords": [
    "ai",
    "due-diligence",
    "olostep",
    "crustdata",
    "homingo-hackathon"
  ],
  "author": "Team Tacticals (Tanmay Shinde & Antara Parab)",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
