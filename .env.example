# VettingCopilot Environment Variables

# Olostep Web Crawling & Scraping API Key (https://olostep.com)
OLOSTEP_API_KEY=your_olostep_api_key_here

# Crustdata B2B Company Intelligence API Key (https://app.crustdata.com)
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# Groq or Gemini API Key for LLM Reasoning Engine (Optional for offline fallback)
GROQ_API_KEY=your_groq_api_key_here

# Server Port
PORT=5000
